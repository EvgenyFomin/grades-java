<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="ru.protei.model.Comment" table="comment">
        <id name="id" type="java.lang.Long" column="id">
            <generator class="identity"/>
        </id>

        <property name="text" column="comment_text" type="java.lang.String"/>
        <property name="productId" column="product_id" type="java.lang.Long" not-null="true" update="false" insert="false"/>
        <many-to-one name="product" column="product_id" fetch="select"/>
    </class>
</hibernate-mapping>